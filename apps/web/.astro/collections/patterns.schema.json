{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "emerging",
        "production",
        "foundational"
      ]
    },
    "evidence_grade": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "mixed",
        "unknown"
      ]
    },
    "authors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "based_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "Orchestration & Control",
        "Context & Memory",
        "Feedback Loops",
        "Learning & Adaptation",
        "Reliability & Eval",
        "Security & Safety",
        "Tool Use & Environment",
        "UX & Collaboration",
        "Uncategorized"
      ]
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "early",
        "maturing",
        "mature"
      ]
    },
    "complexity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "very-high"
      ]
    },
    "effort": {
      "type": "string",
      "enum": [
        "hours",
        "days",
        "weeks"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "transformative"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anti_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "authors",
    "category",
    "source",
    "tags"
  ],
  "additionalProperties": false
}