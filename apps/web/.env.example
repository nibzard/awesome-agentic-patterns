# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Optional: Resend Segment ID
# Create or choose a segment in the Resend dashboard and add its ID here
# RESEND_SEGMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Verified sender address for instant Starter Pack, Pack, and Decision Brief emails
# Example: Agentic Patterns <digest@agentic-patterns.com>
# RESEND_FROM_EMAIL=Agentic Patterns <digest@agentic-patterns.com>
