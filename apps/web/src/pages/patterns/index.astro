---
// ABOUTME: Catalog alias at /patterns so older links with filter parameters keep working.
// ABOUTME: Renders the same catalog as the homepage with the canonical URL set to /.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Catalog from '../../components/Catalog.astro';
import MobileNewsletterBanner from '../../components/MobileNewsletterBanner.astro';
import { getAllPatterns } from '../../lib/patterns';

const patterns = await getAllPatterns();
---

<DocsLayout
  title="Patterns - Agentic Patterns"
  description={`Browse ${patterns.length} design patterns for building AI agents.`}
  canonicalPath="/"
>
  <Catalog {patterns}>
    <MobileNewsletterBanner slot="after-intro" />
  </Catalog>
</DocsLayout>
