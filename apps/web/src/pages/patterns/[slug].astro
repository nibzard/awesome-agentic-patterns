---
// ABOUTME: Pattern page in the docs shell: summary, use/avoid lists, every body section, and related patterns.
// ABOUTME: Links a Markdown twin at /patterns/<slug>.md for agents and crawlers.
import DocsLayout from '../../layouts/DocsLayout.astro';
import PatternSource from '../../components/PatternSource.astro';
import PatternActions from '../../components/PatternActions.astro';
import type { PatternEntry } from '../../types';
import { getAllPatterns } from '../../lib/patterns';
import { renderMarkdown } from '../../lib/markdown';
import { splitSections } from '../../lib/sections';
import { pickRelated } from '../../lib/related';

export async function getStaticPaths() {
  const patterns = await getAllPatterns();
  return patterns.map((pattern) => ({
    params: { slug: pattern.slug },
    props: { pattern },
  }));
}

const allPatterns = await getAllPatterns();
const { pattern } = Astro.props as { pattern: PatternEntry };

const repoUrl = 'https://github.com/nibzard/awesome-agentic-patterns';
const editUrl = `${repoUrl}/edit/main/patterns/${pattern.slug}.md`;
const markdownPath = `/patterns/${pattern.slug}.md`;

const sections = splitSections(pattern.body).map((section) => ({
  ...section,
  html: renderMarkdown(section.markdown),
}));

const related = pickRelated(pattern, allPatterns, 4);

const patternByKey = new Map<string, PatternEntry>();
allPatterns.forEach((entry) => {
  patternByKey.set(entry.id, entry);
  patternByKey.set(entry.slug, entry);
});
const antiPatterns = (pattern.anti_patterns || [])
  .map((key) => patternByKey.get(key))
  .filter((entry): entry is PatternEntry => Boolean(entry));

const hasUseAvoid = Boolean(pattern.signals?.length || pattern.anti_signals?.length);
const railLinks = [
  ...(hasUseAvoid ? [{ id: 'use-avoid', label: 'Use or avoid' }] : []),
  ...sections.map(({ id, label }) => ({ id, label })),
  ...(related.length ? [{ id: 'related', label: 'Related patterns' }] : []),
];

const statusLabel = pattern.status.replace(/-/g, ' ');
const extraFacts = [
  { label: 'Complexity', value: pattern.complexity },
  { label: 'Maturity', value: pattern.maturity },
  { label: 'Effort', value: pattern.effort },
  { label: 'Impact', value: pattern.impact },
].filter((fact) => fact.value);
---

<DocsLayout
  title={`${pattern.title} - Agentic Patterns`}
  description={pattern.summary || `Reference entry for ${pattern.title}.`}
  type="article"
  {markdownPath}
  activeCategory={pattern.category}
  activeSlug={pattern.slug}
>
  <article class="pattern" data-pagefind-body>
    <nav class="pattern-crumbs" aria-label="Breadcrumb">
      <a href="/">Patterns</a>
      <span aria-hidden="true">/</span>
      <a href={`/?category=${encodeURIComponent(pattern.category)}`}>{pattern.category}</a>
    </nav>

    <h1 data-pagefind-meta="title">{pattern.title}</h1>
    {pattern.summary && <p class="pattern-summary">{pattern.summary}</p>}

    <div class="pattern-meta" data-pagefind-ignore>
      <span class={`status-pill status-pill--${pattern.status}`}>{statusLabel}</span>
      {pattern.updated_at && <span>Updated {pattern.updated_at}</span>}
      <span>By {pattern.authors.join(', ')}</span>
      {
        pattern.based_on && pattern.based_on.length > 0 && (
          <span>Based on {pattern.based_on.join(', ')}</span>
        )
      }
      {
        extraFacts.map((fact) => (
          <span>
            {fact.label}: {fact.value}
          </span>
        ))
      }
    </div>

    <div data-pagefind-ignore>
      <PatternActions {pattern} {editUrl} {markdownPath} />
    </div>

    {
      hasUseAvoid && (
        <section id="use-avoid" class="pattern-use-avoid" aria-label="When to use this pattern">
          {pattern.signals && pattern.signals.length > 0 && (
            <div class="pattern-box pattern-box--use">
              <h2>Use when</h2>
              <ul>
                {pattern.signals.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
          {pattern.anti_signals && pattern.anti_signals.length > 0 && (
            <div class="pattern-box pattern-box--avoid">
              <h2>Avoid when</h2>
              <ul>
                {pattern.anti_signals.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }

    {
      sections.map((section) => (
        <section id={section.id} class="pattern-section">
          <h2>
            <a href={`#${section.id}`} class="pattern-anchor">
              {section.label}
            </a>
          </h2>
          <div class="prose" set:html={section.html} />
        </section>
      ))
    }

    {
      related.length > 0 && (
        <section id="related" class="pattern-section" data-pagefind-ignore>
          <h2>Related patterns</h2>
          <ul class="pattern-related">
            {related.map((entry) => (
              <li>
                <a href={`/patterns/${entry.slug}`}>
                  <span class="pattern-related-reason">
                    {entry.reason === 'related' ? 'linked' : `shares tags · ${entry.category}`}
                  </span>
                  <span class="pattern-related-title">{entry.title}</span>
                  {entry.summary && <span class="pattern-related-summary">{entry.summary}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      antiPatterns.length > 0 && (
        <section id="anti-patterns" class="pattern-section" data-pagefind-ignore>
          <h2>Anti-patterns</h2>
          <ul class="pattern-related">
            {antiPatterns.map((entry) => (
              <li>
                <a href={`/patterns/${entry.slug}`}>
                  <span class="pattern-related-title">{entry.title}</span>
                  {entry.summary && <span class="pattern-related-summary">{entry.summary}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="pattern-footer" data-pagefind-ignore>
      <a href={editUrl} target="_blank" rel="noreferrer">Edit this pattern on GitHub</a>
      <a href={markdownPath}>View as Markdown</a>
      <a href="/contribute">Propose a new pattern</a>
    </footer>
  </article>

  <div slot="rail" class="pattern-rail">
    <p class="section-label">On this page</p>
    <nav aria-label="Pattern sections" class="pattern-rail-nav">
      {
        railLinks.map((link) => (
          <a href={`#${link.id}`} data-rail-link={link.id}>
            {link.label}
          </a>
        ))
      }
    </nav>

    {
      pattern.source && (
        <div class="pattern-rail-block">
          <PatternSource source={pattern.source} />
        </div>
      )
    }

    {
      pattern.tags.length > 0 && (
        <div class="pattern-rail-block">
          <p class="section-label">Tags</p>
          <div class="pattern-rail-tags">
            {pattern.tags.map((tag) => (
              <a href={`/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</DocsLayout>

<script>
  import mermaid from 'mermaid';

  const mermaidNodes = document.querySelectorAll<HTMLElement>('.mermaid');
  if (mermaidNodes.length > 0) {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'neutral' });
    mermaid.run({ nodes: mermaidNodes });
  }

  // Highlight the section in view in the right rail.
  const railLinks = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')).map((link) => [
      link.dataset.railLink,
      link,
    ])
  );
  if (railLinks.size > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          railLinks.forEach((link) => link.classList.remove('active'));
          railLinks.get(entry.target.id)?.classList.add('active');
        });
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    railLinks.forEach((_link, id) => {
      const target = id ? document.getElementById(id) : null;
      if (target) observer.observe(target);
    });
  }
</script>

<style>
  .pattern {
    max-width: 48rem;
  }

  .pattern-crumbs {
    display: flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .pattern-crumbs a:hover {
    color: var(--color-primary);
  }

  .pattern h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .pattern-summary {
    margin: 0.6rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text-muted-strong);
  }

  .pattern-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .pattern-use-avoid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pattern-box {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .pattern-box h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pattern-box--use h2 {
    color: var(--color-success);
  }

  .pattern-box--avoid h2 {
    color: var(--color-primary);
  }

  .pattern-box ul {
    margin-top: 0.45rem;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-muted-strong);
  }

  .pattern-box li + li {
    margin-top: 0.25rem;
  }

  .pattern-section {
    margin-top: 2.25rem;
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .pattern-section > h2 {
    font-size: 1.3rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pattern-anchor:hover::after {
    content: ' #';
    color: var(--color-text-muted);
  }

  .prose {
    margin-top: 0.9rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 0 0 0.9rem;
  }

  .prose :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
  }

  .prose :global(h4) {
    margin: 1.25rem 0 0.4rem;
    font-size: 0.95rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 0.9rem;
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin: 0.25rem 0;
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(code) {
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm);
    background: var(--code-bg);
    font-size: 0.85em;
  }

  .prose :global(pre) {
    margin: 0 0 1rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    background: var(--code-block-bg);
    color: var(--code-block-fg);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }

  .prose :global(blockquote) {
    margin: 0 0 1rem;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 3px solid var(--color-divider);
    color: var(--color-text-muted);
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    margin: 0 0 1rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--color-bg-soft);
    font-weight: 600;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .pattern-related {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .pattern-related a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .pattern-related a:hover {
    border-color: var(--color-divider);
  }

  .pattern-related-reason {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .pattern-related-title {
    font-weight: 550;
  }

  .pattern-related-summary {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .pattern-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .pattern-footer a {
    color: var(--color-primary);
  }

  .pattern-rail {
    position: sticky;
    top: calc(var(--header-height) + 1px);
    padding: 1.75rem 0 2rem;
    max-height: calc(100vh - var(--header-height));
    overflow-y: auto;
    font-size: 0.8125rem;
  }

  .pattern-rail-nav {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.5rem;
    border-left: 1px solid var(--color-border);
  }

  .pattern-rail-nav a {
    padding: 0.2rem 0 0.2rem 0.75rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--color-text-muted);
  }

  .pattern-rail-nav a:hover {
    color: var(--color-text);
  }

  .pattern-rail-nav a.active {
    border-left-color: var(--color-primary);
    color: var(--color-text);
  }

  .pattern-rail-block {
    margin-top: 1.5rem;
  }

  .pattern-rail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }

  .pattern-rail-tags a {
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    background: var(--surface-pill);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .pattern-rail-tags a:hover {
    color: var(--color-text);
  }
</style>
