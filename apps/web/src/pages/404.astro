---
// ABOUTME: Not-found page in the docs shell: says the URL has no page and links to the places to look next.
// ABOUTME: The sidebar stays visible so a reader can go straight to a category.
import DocsLayout from '../layouts/DocsLayout.astro';
---

<DocsLayout title="Page not found - Agentic Patterns">
  <article class="not-found">
    <p class="section-label">404</p>
    <h1>Page not found</h1>
    <p class="not-found-lede">
      There is no page at this URL. The pattern may have a different slug, or the link may be old.
    </p>
    <ul>
      <li><a href="/">Browse all patterns</a> and filter by name or tag</li>
      <li>Press <kbd>⌘K</kbd> or <kbd>Ctrl K</kbd> to search the full text</li>
      <li><a href="/llms.txt">/llms.txt</a> lists every slug</li>
      <li>
        <a
          href="https://github.com/nibzard/awesome-agentic-patterns/issues"
          target="_blank"
          rel="noreferrer">Report a broken link</a
        >
      </li>
    </ul>
  </article>
</DocsLayout>

<style>
  .not-found {
    max-width: 46rem;
    line-height: var(--leading-prose);
  }

  .not-found h1 {
    margin-top: 0.4rem;
    font-size: 1.75rem;
  }

  .not-found-lede {
    margin-top: 0.5rem;
    color: var(--text-muted-strong);
    font-size: 1.0625rem;
  }

  .not-found ul {
    margin-top: 1.25rem;
    padding-left: 1.2rem;
  }

  .not-found li {
    margin: 0.3rem 0;
  }

  .not-found a {
    color: var(--color-primary);
  }

  .not-found kbd {
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--code-bg);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
</style>
