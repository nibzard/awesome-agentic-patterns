---
// ABOUTME: Homepage: the full pattern catalog inside the docs shell.
// ABOUTME: /patterns renders the same catalog and points its canonical URL here.
import DocsLayout from '../layouts/DocsLayout.astro';
import Catalog from '../components/Catalog.astro';
import { getAllPatterns } from '../lib/patterns';

const patterns = await getAllPatterns();
---

<DocsLayout
  title="Agentic Patterns: design patterns for building AI agents"
  description={`An open catalogue of ${patterns.length} design patterns for building AI agents, as plain Markdown for people and agents.`}
>
  <Catalog {patterns} />
</DocsLayout>
