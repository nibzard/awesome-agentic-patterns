    margin-top: 0.75rem;
    overflow-x: auto;
  }

  .agents-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .agents-table th,
  .agents-table td {
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .agents-table th {
