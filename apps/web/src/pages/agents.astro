    border-bottom: 1px solid var(--color-border);
    font-size: 1.2rem;
  }

  .agents-page p {
    margin: 0.75rem 0;
  }

  .agents-page a {
    color: var(--color-primary);
  }

  .agents-page :not(pre) > code {
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm);
    background: var(--code-bg);
    font-size: 0.85em;
  }

  .agents-page pre {
