---
// ABOUTME: Guide page in the docs shell: title, one-line description, and the rendered MDX body.
// ABOUTME: The body uses the shared .prose styles so guides read like pattern pages.
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<DocsLayout
  title={`${guide.data.title} - Agentic Patterns`}
  description={guide.data.description}
  type="article"
>
  <article class="guide" data-pagefind-body>
    <nav class="guide-crumbs" aria-label="Breadcrumb">
      <a href="/guides">Guides</a>
    </nav>
    <h1>{guide.data.title}</h1>
    {guide.data.description && <p class="guide-summary">{guide.data.description}</p>}

    <div class="prose guide-body">
      <Content />
    </div>
  </article>
</DocsLayout>

<style>
  .guide {
    max-width: 48rem;
  }

  .guide-crumbs {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .guide-crumbs a:hover {
    color: var(--color-primary);
  }

  .guide h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .guide-summary {
    margin: 0.6rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text-muted-strong);
  }

  .guide-body {
    margin-top: 1.5rem;
  }

  .guide-body :global(h2) {
    margin: 2.25rem 0 0.9rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.3rem;
  }
</style>
