---
// ABOUTME: Guides index in the docs shell: one row per guide with its title and one-line description.
// ABOUTME: Guides sort by their `order` front-matter value, then by title.
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');

const sortedGuides = guides.sort((a, b) => {
  const aOrder = a.data.order ?? 999;
  const bOrder = b.data.order ?? 999;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return a.data.title.localeCompare(b.data.title);
});
---

<DocsLayout
  title="Guides - Agentic Patterns"
  description="Guides that compare related agent design patterns and show which to apply first."
>
  <article class="guides-page">
    <h1>Guides</h1>
    <p class="guides-lede">
      Each guide compares a group of related patterns and tells you which to apply first. For one
      pattern, open its page from the <a href="/">catalog</a>.
    </p>

    <ol class="guides-list">
      {
        sortedGuides.map((guide) => (
          <li>
            <a href={`/guides/${guide.id}`} class="guides-row">
              <span class="guides-row-title">{guide.data.title}</span>
              {guide.data.description && (
                <span class="guides-row-description">{guide.data.description}</span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </article>
</DocsLayout>

<style>
  .guides-page {
    max-width: 46rem;
  }

  .guides-page h1 {
    font-size: 1.75rem;
  }

  .guides-lede {
    margin-top: 0.5rem;
    line-height: 1.7;
    color: var(--text-muted-strong);
    font-size: 1.0625rem;
  }

  .guides-lede a {
    color: var(--color-primary);
  }

  .guides-list {
    list-style: none;
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .guides-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .guides-row:hover .guides-row-title {
    color: var(--color-primary);
  }

  .guides-row-title {
    font-weight: 600;
  }

  .guides-row-description {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
