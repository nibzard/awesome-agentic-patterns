---
// ABOUTME: Site footer: link columns, an optional one-line newsletter signup, and the license line.
// ABOUTME: Pages with the docs sidebar hide the footer signup, because the sidebar shows it.
import NewsletterCTA from './NewsletterCTA.astro';

interface Props {
  newsletter?: boolean;
}

const { newsletter = true } = Astro.props;

const currentYear = new Date().getFullYear();
const repoUrl = 'https://github.com/nibzard/awesome-agentic-patterns';

const footerSections = [
  {
    title: 'Library',
    links: [
      { href: '/', label: 'All patterns' },
      { href: '/guides', label: 'Guides' },
      { href: '/decision', label: 'Decision guide' },
      { href: '/graph', label: 'Pattern graph' },
    ],
  },
  {
    title: 'For agents',
    links: [
      { href: '/agents', label: 'How to use' },
      { href: '/llms.txt', label: 'llms.txt' },
      { href: '/patterns.json', label: 'patterns.json' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/contribute', label: 'Propose a pattern' },
      { href: repoUrl, label: 'GitHub' },
      { href: 'https://x.com/nibzard', label: 'Twitter' },
    ],
  },
  {
    title: 'Policy',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-links">
      {
        footerSections.map((section) => (
          <div class="footer-section">
            <h2 class="footer-section-title">{section.title}</h2>
            <ul class="footer-section-links">
              {section.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      newsletter && (
        <div class="footer-newsletter">
          <NewsletterCTA
            variant="compact"
            title="Get an email when new patterns land"
            buttonText="Subscribe"
          />
        </div>
      )
    }

    <p class="footer-copyright">
      &copy; {currentYear} Awesome Agentic Patterns contributors. Apache-2.0. <a
        href={repoUrl}
        class="footer-link">Source on GitHub</a
      >.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    font-size: 0.8125rem;
  }

  .footer-container {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 10rem));
    gap: 1.5rem;
  }

  .footer-section-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer-section-links {
    list-style: none;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-link {
    color: var(--color-text);
  }

  .footer-link:hover {
    color: var(--color-primary);
  }

  .footer-newsletter {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-copyright {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .footer-container {
      padding: 1.5rem 1rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
