---
// ABOUTME: Source block in the pattern page rail: a label and one link to the primary source.
// ABOUTME: Shows a short host/path label on one line; the full URL is in the title attribute.
import { sourceLabel } from '../lib/source-label';

interface Props {
  source?: string;
}

const { source } = Astro.props;
const isUrl = Boolean(source && /^https?:\/\//.test(source));
---

{
  source && (
    <div class="pattern-source-block">
      <p class="section-label">Source</p>
      {isUrl ? (
        <a
          href={source}
          title={source}
          target="_blank"
          rel="noopener noreferrer"
          class="pattern-source-link"
        >
          {sourceLabel(source)}
        </a>
      ) : (
        <p class="pattern-source-text">{source}</p>
      )}
    </div>
  )
}

<style>
  .pattern-source-link {
    display: block;
    margin-top: 0.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .pattern-source-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pattern-source-text {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
