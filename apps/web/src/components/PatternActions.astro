---
// ABOUTME: Action row on a pattern page: one primary copy-for-agent button, then quiet links to copy, view, edit, cite.
// ABOUTME: Markdown and agent-prompt text come from lib/pattern-markdown so they match the .md endpoint.
import CopyButton from './CopyButton.astro';
import { SITE_URL, patternToAgentPrompt, patternToMarkdown } from '../lib/pattern-markdown';

interface Props {
  pattern: {
    title: string;
    slug: string;
    summary?: string;
    status: string;
    category?: string;
    complexity?: string;
    maturity?: string;
    effort?: string;
    impact?: string;
    authors: string[];
    tags: string[];
    source?: string;
    signals?: string[];
    anti_signals?: string[];
    body: string;
    updated_at?: string;
  };
  editUrl?: string;
  markdownPath?: string;
}

const { pattern, editUrl, markdownPath } = Astro.props;

function formatAuthors(authors: string[]): string {
  if (authors.length === 0) return 'Awesome Agentic Patterns';
  if (authors.length === 1) return authors[0];
  if (authors.length === 2) return `${authors[0]} & ${authors[1]}`;
  return `${authors.slice(0, -1).join(', ')}, & ${authors[authors.length - 1]}`;
}

function formatBibtexAuthors(authors: string[]): string {
  if (authors.length === 0) return 'Awesome Agentic Patterns';
  return authors.join(' and ');
}

function getCitationYear(updatedAt?: string): string {
  if (!updatedAt) return String(new Date().getFullYear());
  const match = updatedAt.match(/^\d{4}/);
  return match ? match[0] : String(new Date().getFullYear());
}

const citationYear = getCitationYear(pattern.updated_at);
const retrievalDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const citationUrl = `${SITE_URL}/patterns/${pattern.slug}`;
const authors = formatAuthors(pattern.authors);
const bibtexAuthors = formatBibtexAuthors(pattern.authors);

const apaCitation = `${authors} (${citationYear}). ${pattern.title}. In *Awesome Agentic Patterns*. Retrieved ${retrievalDate}, from ${citationUrl}`;
const bibtexCitation = `@misc{agentic_patterns_${pattern.slug},
  title = {${pattern.title}},
  author = {${bibtexAuthors}},
  year = {${citationYear}},
  howpublished = {\\url{${citationUrl}}},
  note = {Awesome Agentic Patterns}
}`;

const markdownContent = patternToMarkdown(pattern);
const agentPromptContent = patternToAgentPrompt(pattern);
const jsonContent = JSON.stringify(pattern, null, 2);
---

<div class="pattern-actions">
  <button
    class="action-button action-button--primary"
    data-copy="agent prompt"
    data-content={agentPromptContent}
    aria-label="Copy as a prompt for your coding agent"
  >
    Copy for agent
  </button>

  <button
    class="action-link"
    data-copy="markdown"
    data-content={markdownContent}
    aria-label="Copy as Markdown"
  >
    Copy Markdown
  </button>

  <button class="action-link" data-copy="json" data-content={jsonContent} aria-label="Copy as JSON">
    Copy JSON
  </button>

  {
    markdownPath && (
      <a class="action-link" href={markdownPath}>
        View .md
      </a>
    )
  }

  {
    editUrl && (
      <a class="action-link" href={editUrl} target="_blank" rel="noreferrer">
        Edit on GitHub
      </a>
    )
  }

  <details class="citation-details">
    <summary class="action-link" aria-label="Cite this pattern">Cite</summary>
    <div class="citation-panel">
      <div class="citation-row">
        <div class="citation-header">
          <span class="citation-label">APA</span>
          <CopyButton content={apaCitation} label="Copy APA citation" />
        </div>
        <pre class="citation-text">{apaCitation}</pre>
      </div>
      <div class="citation-row">
        <div class="citation-header">
          <span class="citation-label">BibTeX</span>
          <CopyButton content={bibtexCitation} label="Copy BibTeX citation" />
        </div>
        <pre class="citation-text citation-text--code">{bibtexCitation}</pre>
      </div>
    </div>
  </details>

  <details class="agent-preview">
    <summary class="action-link" aria-label="Show the text that Copy for agent copies"
      >What gets copied</summary
    >
    <pre class="agent-preview-text">{agentPromptContent}</pre>
  </details>

  <span class="copy-feedback" aria-live="polite"></span>
</div>

<div class="copy-nudge" data-copy-nudge data-category={pattern.category || ''} hidden>
  <div class="copy-nudge-header">
    <p class="copy-nudge-text">
      Copied for your agent. Want new <strong>{pattern.category || 'agent'}</strong> patterns like this
      (1–2×/mo) + our Starter Pack?
    </p>
    <button
      type="button"
      class="copy-nudge-dismiss"
      data-copy-nudge-dismiss
      aria-label="Dismiss signup prompt"
    >
      ×
    </button>
  </div>
  <form class="copy-nudge-form" data-copy-nudge-form>
    <input
      type="email"
      name="email"
      placeholder="you@company.com"
      required
      class="copy-nudge-input"
      aria-label="Email address"
    />
    <button type="submit" class="copy-nudge-submit">Subscribe</button>
    <span class="copy-nudge-status" data-copy-nudge-status role="status" aria-live="polite"></span>
  </form>
</div>

<script>
  import {
    NUDGE_DISMISSED_KEY,
    SUBSCRIBED_EVENT,
    isDismissedWithinDays,
    isSubscribed,
    markDismissed,
    submitSubscription,
    trackNewsletterEvent,
  } from '../lib/newsletter-client';

  const buttons = document.querySelectorAll('[data-copy]');
  const feedback = document.querySelector('.copy-feedback');
  const copyNudge = document.querySelector<HTMLElement>('[data-copy-nudge]');
  const copyNudgeForm = document.querySelector<HTMLFormElement>('[data-copy-nudge-form]');
  const copyNudgeDismiss = document.querySelector<HTMLButtonElement>('[data-copy-nudge-dismiss]');
  const copyNudgeStatus = document.querySelector<HTMLElement>('[data-copy-nudge-status]');

  function maybeShowCopyNudge() {
    if (!copyNudge || !copyNudge.hidden) return;
    if (isSubscribed() || isDismissedWithinDays(NUDGE_DISMISSED_KEY, 30)) return;
    copyNudge.hidden = false;
    trackNewsletterEvent('copy_nudge_shown', {
      category: copyNudge.dataset.category || '',
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const content = button.getAttribute('data-content');
      const format = button.getAttribute('data-copy');

      if (!content) return;

      try {
        await navigator.clipboard.writeText(content);
        if (feedback) {
          feedback.textContent = `Copied ${format}.`;
          setTimeout(() => {
            feedback.textContent = '';
          }, 2000);
        }
        maybeShowCopyNudge();
      } catch {
        if (feedback) {
          feedback.textContent = 'Failed to copy';
          setTimeout(() => {
            feedback.textContent = '';
          }, 2000);
        }
      }
    });
  });

  copyNudgeDismiss?.addEventListener('click', () => {
    markDismissed(NUDGE_DISMISSED_KEY);
    if (copyNudge) copyNudge.hidden = true;
  });

  copyNudgeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = copyNudgeForm.querySelector<HTMLInputElement>('input[type="email"]');
    const submitBtn = copyNudgeForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const email = input?.value.trim();
    if (!email || !submitBtn || !copyNudgeStatus) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    copyNudgeStatus.textContent = '';
    copyNudgeStatus.className = 'copy-nudge-status';

    try {
      const result = await submitSubscription({
        email,
        source: 'post-copy',
        category: copyNudge?.dataset.category || undefined,
        deliverable: 'starter-pack',
      });

      if (result.ok) {
        copyNudgeStatus.textContent = '';
        copyNudgeStatus.classList.add('copy-nudge-status--success');
        const msg = document.createTextNode(`${result.message || 'Subscribed!'} `);
        copyNudgeStatus.appendChild(msg);
        if (result.downloadUrl) {
          const link = document.createElement('a');
          link.href = result.downloadUrl;
          link.textContent = 'Open Starter Pack (.md) →';
          copyNudgeStatus.appendChild(link);
        }
        if (input) input.value = '';
        submitBtn.textContent = 'Subscribed ✓';
      } else {
        copyNudgeStatus.textContent = result.error || 'Could not subscribe.';
        copyNudgeStatus.classList.add('copy-nudge-status--error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Subscribe';
      }
    } catch {
      copyNudgeStatus.textContent = 'Network error. Please try again.';
      copyNudgeStatus.classList.add('copy-nudge-status--error');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subscribe';
    }
  });

  window.addEventListener(SUBSCRIBED_EVENT, () => {
    if (copyNudge && !copyNudgeForm?.contains(document.activeElement)) {
      copyNudge.hidden = true;
    }
  });
</script>

<style>
  .pattern-actions {
    display: flex;
    gap: 0.4rem 0.9rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 1rem;
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 0.38rem 0.7rem;
    background-color: var(--surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .action-button:hover {
    border-color: var(--color-divider);
  }

  .action-button--primary {
    background-color: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  .action-button--primary:hover {
    background-color: var(--text-muted-strong);
    border-color: var(--text-muted-strong);
  }

  .action-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .action-button svg {
    flex-shrink: 0;
  }

  .action-link {
    padding: 0.2rem 0.1rem;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .action-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .action-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .citation-details[open],
  .agent-preview[open] {
    flex-basis: 100%;
  }

  .agent-preview summary {
    list-style: none;
  }

  .agent-preview summary::-webkit-details-marker {
    display: none;
  }

  .agent-preview-text {
    margin: var(--spacing-sm) 0 0;
    max-height: 20rem;
    overflow: auto;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    background: var(--code-block-bg);
    color: var(--code-block-fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .citation-details summary {
    list-style: none;
  }

  .citation-details summary::-webkit-details-marker {
    display: none;
  }

  .citation-panel {
    margin-top: var(--spacing-sm);
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
    display: grid;
    gap: var(--spacing-md);
    box-shadow: var(--shadow-sm);
  }

  .citation-row {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .citation-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
  }

  .citation-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted-strong);
  }

  .citation-text {
    margin: 0;
    padding: 0.9rem;
    background-color: var(--color-bg-soft);
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    color: var(--color-text);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .citation-text--code {
    font-family: var(--font-mono);
  }

  .copy-feedback {
    font-size: 0.82rem;
    color: var(--color-success);
    margin-left: var(--spacing-sm);
    align-self: center;
  }

  .copy-nudge {
    margin-top: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .copy-nudge-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .copy-nudge-text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-muted-strong);
  }

  .copy-nudge-dismiss {
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.1rem 0.25rem;
    cursor: pointer;
  }

  .copy-nudge-dismiss:hover {
    color: var(--color-text);
  }

  .copy-nudge-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .copy-nudge-input {
    flex: 1 1 12rem;
    min-width: 0;
    max-width: 17rem;
    height: 2rem;
    padding: 0 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    font-size: 0.8125rem;
  }

  .copy-nudge-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .copy-nudge-submit {
    height: 2rem;
    padding: 0 0.8rem;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .copy-nudge-submit:hover:not(:disabled) {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .copy-nudge-submit:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .copy-nudge-status {
    flex-basis: 100%;
    font-size: 0.78rem;
  }

  .copy-nudge-status:empty {
    display: none;
  }

  .copy-nudge-status--success {
    color: var(--color-success);
  }

  .copy-nudge-status--success a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .copy-nudge-status--error {
    color: var(--color-error);
  }

  @media (pointer: coarse) {
    .copy-nudge-input {
      font-size: 16px;
    }
  }
</style>
