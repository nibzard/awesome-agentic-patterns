---
// ABOUTME: Mobile-only newsletter banner, slotted under the catalog intro on docs pages.
// ABOUTME: The sidebar form is the desktop surface; this banner keeps mobile visible without opening the drawer.
import NewsletterCTA from './NewsletterCTA.astro';
---

<div class="mobile-newsletter-banner">
  <NewsletterCTA
    variant="banner"
    title="Get new patterns by email"
    description="A short note when new patterns land. No spam."
    buttonText="Subscribe"
  />
</div>

<style>
  .mobile-newsletter-banner {
    display: none;
  }

  @media (max-width: 960px) {
    .mobile-newsletter-banner {
      display: block;
      margin-top: 1.25rem;
      padding: 1rem 0.875rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg-elevated);
    }
  }
</style>
